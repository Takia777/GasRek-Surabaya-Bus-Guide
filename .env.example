# Copy this file to .env and fill in your own values.
# Never commit .env.

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Chatbot (LLM)
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
CHATBOT_USE_FALLBACK=false

# Rules
RULES_ENGINE=prolog
